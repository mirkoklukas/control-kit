<mujoco model="hexapod">
  <compiler angle="degree" autolimits="true"/>
  <!-- Newton defaults to 100/50 iterations; a hexapod converges in far fewer, and
       MJX runs them as a fixed batched loop, so trimming these is a big speedup. -->
  <option timestep="0.004" integrator="implicitfast" iterations="10" ls_iterations="8"/>

  <!-- Radial hexapod: a hexagonal base with one leg at each of the 6 corners.
       Corners sit at angles 30, 90, 150, 210, 270, 330 deg (circumradius 0.12), so each
       leg points straight out along its corner's bearing. Per leg: coxa (yaw) -> femur
       (lift) -> tibia (knee), 18 actuated DOF. Leg-local frame: +x outward, +z up; the
       leg body is rotated about z by its corner angle and the same recipe is reused.
       At all-zero joint angles the legs splay out and down into a standing pose. -->
  <default>
    <!-- Collision filtering: robot geoms collide with the floor only (contype=0,
         conaffinity=1), never each other; the floor sets contype=1 below. Cuts the
         broad-phase pairs ~12x (312 -> 26), the main MJX per-step cost here. -->
    <geom density="600" friction="1.0 0.5 0.5" contype="0" conaffinity="1"/>
    <default class="hexapod">
      <joint type="hinge" armature="0.008" damping="0.4" frictionloss="0.02"/>
      <geom type="capsule" size="0.012" rgba="0.55 0.58 0.62 1"/>
      <position kp="25" kv="2.5" forcerange="-15 15"/>
      <default class="coxa">
        <joint axis="0 0 1" range="-45 45"/>
        <geom material="coxa"/>
      </default>
      <default class="femur">
        <joint axis="0 1 0" range="-75 75"/>
        <geom material="femur"/>
      </default>
      <default class="tibia">
        <joint axis="0 1 0" range="-110 30"/>
        <geom material="tibia"/>
      </default>
    </default>
  </default>

  <asset>
    <!-- ===== COLORS: edit the rgba here to recolor each part ===== -->
    <material name="base"  rgba="0.85 0.5  0.2  1"/>
    <material name="head"  rgba="0.9  0.6  0.25 1"/>
    <material name="coxa"  rgba="0.85 0.2  0.2  1"/>
    <material name="femur" rgba="0.2  0.4  0.85 1"/>
    <material name="tibia" rgba="0.9  0.8  0.15 1"/>
    <material name="foot"  rgba="0.15 0.15 0.2  1"/>
    <!-- =========================================================== -->

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="10 10" reflectance="0.2"/>
    <!-- Hexagonal prism: 6 top + 6 bottom corners at circumradius 0.12, half-thickness 0.025.
         MuJoCo takes the convex hull, giving a clean hexagon body. -->
    <mesh name="hexbody" vertex="
       0.10392  0.06   0.025
       0.0      0.12   0.025
      -0.10392  0.06   0.025
      -0.10392 -0.06   0.025
       0.0     -0.12   0.025
       0.10392 -0.06   0.025
       0.10392  0.06  -0.025
       0.0      0.12  -0.025
      -0.10392  0.06  -0.025
      -0.10392 -0.06  -0.025
       0.0     -0.12  -0.025
       0.10392 -0.06  -0.025"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.0" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid" contype="1" conaffinity="1"/>

    <body name="base" pos="0 0 0.20">
      <freejoint name="root"/>
      <geom name="base" type="mesh" mesh="hexbody" material="base"/>

      <!-- Head: a box welded to the top of the +x-facing hexagon face (the edge
           between the FR @330 and FL @30 corners, at x=0.10392, y in [-0.06,0.06]).
           Sits on the top surface (z=0.025) and overhangs forward along +x. -->
      <geom name="head" type="box" pos="0.09 0 0.0125" size="0.02 0.03 0.02" material="head"/>

      <!-- 6 identical legs at the hexagon corners. Define one leg at the +x-side
           FL corner (30 deg) and replicate it 6x, rotating 60 deg about z each
           time, so legs land at 30, 90, 150, 210, 270, 330 deg. Replicate appends
           the copy index to every name; the mapping is:
             0 = FL (30)   1 = ML (90)   2 = BL (150)
             3 = BR (210)  4 = MR (270)  5 = FR (330)  -->
      <replicate count="6" euler="0 0 60">
        <body name="coxa" pos="0.10392 0.06 0" euler="0 0 30" childclass="hexapod">
          <joint name="coxa" class="coxa"/>
          <geom class="coxa" fromto="0 0 0 0.06 0 0"/>
          <body name="femur" pos="0.06 0 0">
            <joint name="femur" class="femur"/>
            <geom class="femur" fromto="0 0 0 0.10 0 0"/>
            <body name="tibia" pos="0.10 0 0">
              <joint name="tibia" class="tibia"/>
              <geom class="tibia" fromto="0 0 0 0.05 0 -0.19" size="0.010"/>
              <geom name="foot" type="sphere" pos="0.05 0 -0.19" size="0.018" material="foot"/>
              <site name="foot" pos="0.05 0 -0.19" size="0.012"/>
            </body>
          </body>
        </body>
      </replicate>
    </body>
  </worldbody>

  <!-- 3 position servos per leg. <replicate> above auto-duplicates these to
       coxaN / femurN / tibiaN (N=0..5), 18 actuators total, in per-leg order
       (coxa0, femur0, tibia0, coxa1, ...). Targets default to 0 -> splayed stand. -->
  <actuator>
    <position name="coxa"  joint="coxa"  class="hexapod"/>
    <position name="femur" joint="femur" class="hexapod"/>
    <position name="tibia" joint="tibia" class="hexapod"/>
  </actuator>
</mujoco>
