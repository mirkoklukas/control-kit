      <body name="coxa4" pos="-2.75546e-17 -0.15 0" euler="0 0 270" childclass="hexapod">
        <joint name="coxa4" class="coxa"/>
        <geom class="coxa" fromto="0 0 0 0.026 0 0"/>
        <body name="femur4" pos="0.026 0 0">
          <joint name="femur4" class="femur"/>
